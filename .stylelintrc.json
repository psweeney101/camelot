{
  "ignoreFiles": ["**/*"],
  "overrides": [
    {
      "files": ["**/*.css"],
      "extends": ["stylelint-config-standard", "stylelint-config-tailwindcss"],
      "rules": {}
    },
    {
      "files": ["**/*.scss"],
      "extends": [
        "stylelint-config-standard-scss",
        "stylelint-config-tailwindcss/scss"
      ],
      "rules": {}
    },
    {
      "files": ["**/*.css", "**/*.scss"],
      "extends": ["stylelint-config-clean-order/error"],
      "rules": {}
    }
  ],
  "rules": {
    "no-empty-source": null
  }
}
