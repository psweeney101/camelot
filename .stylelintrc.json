{
  "ignoreFiles": ["**/*"],
  "overrides": [
    {
      "files": ["**/*.css"],
      "extends": ["stylelint-config-standard"],
      "rules": {}
    },
    {
      "files": ["**/*.scss"],
      "extends": ["stylelint-config-standard-scss"],
      "rules": {}
    },
    {
      "files": ["**/*.css", "**/*.scss"],
      "extends": ["stylelint-config-clean-order/error"],
      "rules": {}
    }
  ],
  "rules": {
    "no-empty-source": null
  }
}
