{
  "name": "@camelot/components",
  "version": "0.0.1",
  "sideEffects": [
    "./src/styles/*.css"
  ],
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "cn": "^0.5.2"
  },
  "nx": {
    "targets": {
      "stylelint": {
        "executor": "nx-stylelint:lint",
        "outputs": [
          "{options.outputFile}"
        ],
        "options": {
          "lintFilePatterns": [
            "libs/components/**/*.css",
            "libs/components/**/*.scss"
          ]
        }
      }
    }
  }
}
