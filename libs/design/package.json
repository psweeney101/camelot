{
  "name": "@camelot/design",
  "version": "0.0.1",
  "sideEffects": [
    "./src/lib/*.css"
  ],
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/lib/theme.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0"
  },
  "nx": {
    "targets": {
      "stylelint": {
        "executor": "nx-stylelint:lint",
        "outputs": [
          "{options.outputFile}"
        ],
        "options": {
          "lintFilePatterns": [
            "src/**/*.css",
            "src/**/*.scss"
          ]
        }
      },
      "storybook": {
        "options": {
          "args": [
            "--host=0.0.0.0",
            "--port=6006",
            "--no-open"
          ]
        }
      }
    }
  }
}
