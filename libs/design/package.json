{
  "name": "@camelot/design",
  "version": "0.0.1",
  "sideEffects": [
    "./src/lib/*.css"
  ],
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/lib/theme.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "nx": {
    "targets": {
      "stylelint": {
        "executor": "nx-stylelint:lint",
        "outputs": [
          "{options.outputFile}"
        ],
        "options": {
          "lintFilePatterns": [
            "libs/design/**/*.css",
            "libs/design/**/*.scss"
          ]
        }
      },
      "storybook": {
        "options": {
          "args": [
            "--host=0.0.0.0",
            "--port=6006",
            "--no-open"
          ]
        }
      }
    }
  }
}
